#!/usr/bin/env bash
set -Eeuo pipefail
project_root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ "$(uname -s)" == Darwin ]]; then
  binary="$project_root/build/local-arena/bin/arena-agent-macos"
else
  binary="$project_root/build/local-arena/bin/arena-agent"
fi
if [[ ! -x "$binary" ]]; then
  echo "Missing local Go binary: $binary. Install the released client bundle, or build ./cmd/arena-agent into this path." >&2
  exit 1
fi
exec "$binary" "$@"
