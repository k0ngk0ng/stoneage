#!/usr/bin/env bash
set -Eeuo pipefail
project_root="$(cd "$(dirname "$0")/.." && pwd)"
docker_bin="${STONEAGE_DOCKER_BIN:-docker}"
env_file="${STONEAGE_ENV_FILE:-$project_root/.env}"
compose_file="$project_root/docker-compose.yml"
ai_compose_file="$project_root/docker-compose.ai.yml"

# Read only the selected deployment flag. Never source the env file: it may
# contain credentials and deployment paths supplied by the operator.
env_value()
{
  local key="$1"
  awk -v key="$key" '
    {
      sub(/\r$/, "")
      line=$0
      sub(/^[[:space:]]*(export[[:space:]]+)?/, "", line)
      pos=index(line, "=")
      if (!pos) next
      name=substr(line, 1, pos-1)
      sub(/[[:space:]]+$/, "", name)
      if (name != key) next
      value=substr(line, pos+1)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+#.*$/, "", value)
      sub(/[[:space:]]+$/, "", value)
      if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) value=substr(value, 2, length(value)-2)
      result=value
    }
    END { print result }
  ' "$env_file"
}

ai_mode="${STONEAGE_AI_CONTAINER_MODE:-}"
if [[ -z "$ai_mode" && -f "$env_file" ]]; then
  ai_mode="$(env_value STONEAGE_AI_CONTAINER_MODE)"
fi
ai_mode_lower="$(printf '%s' "$ai_mode" | tr '[:upper:]' '[:lower:]')"
case "$ai_mode_lower" in
  ""|0|false|no|off) ai_container=0 ;;
  1|true|yes|on|container) ai_container=1 ;;
  *)
    echo "STONEAGE_AI_CONTAINER_MODE must be false or true (got: $ai_mode)" >&2
    exit 2
    ;;
esac
compose_args=(--project-directory "$project_root" --env-file "$env_file" -f "$compose_file")
if (( ai_container )); then
  [[ -f "$ai_compose_file" ]] || { echo "Automation Compose overlay not found: $ai_compose_file" >&2; exit 1; }
  compose_args+=( -f "$ai_compose_file" )

fi
command="${1:-help}"
if (( $# )); then shift; fi
case "$command" in
  battle-dataset)
    version="${STONEAGE_VERSION:-$(env_value STONEAGE_VERSION)}"
    legacy_image="${STONEAGE_LEGACY_IMAGE:-$(env_value STONEAGE_LEGACY_IMAGE)}"
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9._-]+)?$ ]] || {
      echo 'battle-dataset requires an explicit STONEAGE_VERSION release tag' >&2; exit 2;
    }
    export STONEAGE_BATTLE_DATASET_IMAGE="${legacy_image:-ghcr.io/k0ngk0ng/stoneage/legacy-runtime}:$version"
    exec "$project_root/bin/battle-dataset.sh" "$@" ;;
  battle-export) exec python3 "$project_root/bin/battle-export.py" "$@" ;;
  init) exec "$project_root/bin/deploy.sh" --init "$@" ;;
  check) exec "$project_root/bin/deploy.sh" --check "$@" ;;
  # Deployment pulls while services stay online, then replaces containers.
  # Do not add a pre-stop or backup step to ordinary image-only releases.
  deploy) exec "$project_root/bin/deploy.sh" "$@" ;;
  sync-assets) exec "$project_root/bin/sync-assets.sh" "$@" ;;
  login) exec "$project_root/bin/registry-login.sh" "$@" ;;
  clean) exec "$project_root/bin/clean-images.sh" "$@" ;;
  pull|status|logs|stop)
    action="$command"
    [[ "$action" != status ]] || action=ps
    if [[ "$action" == pull ]]; then
      source "$project_root/bin/registry-login.sh"
      stoneage_registry_login
    fi
    "$docker_bin" compose "${compose_args[@]}" "$action" "$@"
    exit 0
    ;;
  help|-h|--help) echo 'Usage: bin/stoneage {init|check|login|pull|deploy|status|logs|stop|sync-assets|clean|battle-dataset|battle-export} [options]' ;;
  *) echo "Unknown command: $command" >&2; exit 2 ;;
esac
