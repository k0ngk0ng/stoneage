# Deployment configuration template. Generate the actual .env with:
#   ./bin/deploy.sh --init
# Review/edit .env and config/{gateway/gateway.toml,web/web.toml,gmsv/setup.cf,saac/acserv.cf}
# before running ./bin/deploy.sh. --prepare-config creates missing server
# configs (migrating existing runtime configs when available; never overwrites).
# Keep defaults for ordinary settings; fill environment-specific paths,
# image repositories and public resource/CDN addresses as needed.
# After editing .env: ./bin/deploy.sh --check, then deploy again.
# Keep this file private; it contains the initial administrator password.
# Image repositories do not include a tag; STONEAGE_VERSION selects the tag.
# For production use the two ghcr.io repositories from the GitHub release.
STONEAGE_VERSION=v0.1.16
STONEAGE_CONTROL_IMAGE=ghcr.io/k0ngk0ng/stoneage/control-plane
STONEAGE_LEGACY_IMAGE=ghcr.io/k0ngk0ng/stoneage/legacy-runtime

# Keep the two service data trees separate from image contents. Existing local
# data can be migrated from runtime/legacy-server into these directories.
STONEAGE_GMSV_DATA_ROOT=./data/gmsv
STONEAGE_SAAC_DATA_ROOT=./data/saac
# Config directories are separate from player data. Directory mounts allow
# the admin UI to save changes atomically; do not use single-file mounts here.
STONEAGE_GMSV_CONFIG_DIR=./config/gmsv
STONEAGE_SAAC_CONFIG_DIR=./config/saac
STONEAGE_GATEWAY_CONFIG_FILE=./config/gateway/gateway.toml
# The browser client needs the matching 2.5 client map/DAT, palette and WAV trees.
# Keep this directory read-only inside the web container.
STONEAGE_CLIENT_DATA_ROOT=./assets/client
# Independent sprite resource archive, mounted read-only; never baked into images.
STONEAGE_SPRITES_ROOT=./assets/sprites
STONEAGE_ADMIN_USER=admin
STONEAGE_ADMIN_PASSWORD=replace-with-a-long-random-password
STONEAGE_ADMIN_SETUP_TOKEN=
STONEAGE_ADMIN_COOKIE_SECURE=false
# Add the exact Docker gateway/proxy IP when using a host reverse proxy.
STONEAGE_ADMIN_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Keep container logs bounded on a production host.
STONEAGE_LOG_MAX_SIZE=10m
STONEAGE_LOG_MAX_FILE=5

# Bind the game gateway and admin UI to loopback by default. Set these to a
# trusted LAN address only when a firewall/VPN is already in place.
STONEAGE_GATEWAY_BIND=127.0.0.1
STONEAGE_GATEWAY_PORT=9065
# Gateway listen/upstream/trace settings live in config/gateway/gateway.toml.
# Shared by gateway, admin and service-control under /data in the auth volume.
# Keep this basename for existing installations; changing it selects a new DB.
# Authentication is always required by this deployment.
STONEAGE_AUTH_DB_FILE=stoneage-auth.db
# Leave STONEAGE_GATEWAY_ROUTES unset for this single-line deployment.
STONEAGE_ADMIN_BIND=127.0.0.1
STONEAGE_ADMIN_PORT=18080
# The browser endpoint is separate from the native game gateway. Set the bind
# address to 0.0.0.0 only when the host firewall or a reverse proxy is ready.
STONEAGE_WEB_BIND=127.0.0.1
STONEAGE_WEB_PORT=8088
STONEAGE_WEB_MAX_SESSIONS=64
# Web runtime, object-storage origin and CDN settings are kept together in this file.
# Select provider and endpoint in config/web/web.toml (aliyun-oss or cloudflare-r2).
# The committed default contains no secrets. Access keys are never written to
# the TOML; use the 0600 secret files below (the provider-specific environment
# aliases are provided only for CI/direct invocation).
STONEAGE_WEB_CONFIG_FILE=./config/web/web.toml
# Optional emergency/legacy CDN override. Normally edit static.cdn.base_url
# in config/web/web.toml and leave this empty.
STONEAGE_WEB_CDN_BASE_URL=
# Used by the standalone `bin/stoneage sync-assets` uploader
# (and, when explicitly requested from admin, the fixed service-control task).
# Put each value in a separate chmod 0600 file. They are mounted as Docker
# secrets into the operator; the host uploader reads the files directly.
# Web/admin never receive them.
# The deploy script creates these files when legacy ALIBABA_CLOUD_* values are
# supplied, but file paths are the preferred production configuration.
STONEAGE_ASSET_SYNC_ACCESS_KEY_FILE=./config/secrets/oss-access-key-id
STONEAGE_ASSET_SYNC_ACCESS_SECRET_FILE=./config/secrets/oss-access-key-secret
# Optional compatibility fallback for CI/direct invocation. The uploader also
# accepts AWS_* and CLOUDFLARE_R2_* aliases. Do not leave real values in this
# env file when it is readable by other users.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
STONEAGE_ASSET_SYNC_WORKERS=8

# Named volumes survive container/image replacement. Never use `down -v` on
# this project unless you intentionally want to erase the auth database.
STONEAGE_AUTH_VOLUME=stoneage-auth
STONEAGE_OPERATOR_RUN_VOLUME=stoneage-operator-run

# Optional operator release integration (not exposed by the admin UI). Set these only on a production
# host where the deployment package is installed at this exact absolute path. The
# operator then mounts the same path and can safely run fixed `docker compose`
# commands through the Docker socket.
STONEAGE_PROJECT_ROOT=
STONEAGE_COMPOSE_FILE=
STONEAGE_OPERATOR_STATE_VOLUME=stoneage-operator-state
