# macOS junk
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
.fseventsd

.cache/
build/
dist/
runtime/
vendor/assets/
vendor/archives/
vendor/upstream/

# The 2.5 GMSV/SAAC source and immutable game data are part of this
# repository. Keep generated objects, bundled executables, archive copies,
# logs, and live player/account state out of Git.
server/legacy/source/*
!server/legacy/source/2.5/
!server/legacy/source/2.5/**
server/legacy/source/2.5/**/*.o
server/legacy/source/2.5/**/*.a
server/legacy/source/2.5/**/*.exe
server/legacy/source/2.5/**/*.zip
server/legacy/source/2.5/**/*.bak
server/legacy/source/2.5/**/*.orig
server/legacy/source/2.5/**/*.rej
server/legacy/source/2.5/**/DEADJOE
server/legacy/source/2.5/**/*.scc
server/legacy/source/2.5/**/stoRkxhg
server/legacy/source/2.5/**/debug
server/legacy/source/2.5/**/nohup.out
server/legacy/source/2.5/**/log/*.log*
server/legacy/source/2.5/gmsv/log/
server/legacy/source/2.5/gmsv/lostpet/
server/legacy/source/2.5/saac/char/
server/legacy/source/2.5/saac/char_sleep/
server/legacy/source/2.5/saac/db/
server/legacy/source/2.5/saac/mail/
server/legacy/source/2.5/saac/log/
server/legacy/source/2.5/saac/lock/
server/legacy/source/2.5/saac/data/family/
server/legacy/source/2.5/saac/data/fmpointdir/
server/legacy/source/2.5/saac/data/fmsmemodir/

# Local paths and generated inventory may expose machine-specific locations.
.env
.env.*
!.env.compose.example
.secrets/
# Generated, host-specific game server configuration (templates are versioned).
config/gmsv/setup.cf
config/saac/acserv.cf

# Python bytecode
__pycache__/
*.pyc

# Third-party client source consulted as read-only reference for RE.  Not
# ours to redistribute, so it stays out of the repo.
reference/

# Mobile client generated assets and local build outputs. Keep the client
# source, scene, tests and asset-generation tools in Git; regenerate these
# files locally when needed.
client/mobile/assets/generated/
client/mobile/assets/fonts/
client/mobile/android/.build_version
client/mobile/builds/
online-*.png

# Local browser dogfood captures and reports. These can contain account names,
# screenshots and protocol traces; never include them in a release commit.
dogfood-output/

# Production host state and credentials
/data/
/assets/
/backups/
/config/secrets/
/config/registry/username
/config/registry/token
/config/registry/docker/

# Certificate automation host configuration and credentials
/config/certificates/aliyun.json
/config/certificates/access-key-id
/config/certificates/access-key-secret
