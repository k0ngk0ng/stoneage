# The 2.5 GMSV/SAAC source and immutable game data are part of this
# repository. Keep generated objects, bundled executables, archive copies,
# logs, and live player/account state out of Git.
server/legacy/source/*
!server/legacy/source/2.5/
!server/legacy/source/2.5/**
server/legacy/source/2.5/**/*.o
server/legacy/source/2.5/**/*.a
server/legacy/source/2.5/**/*.exe
server/legacy/source/2.5/**/*.zip
server/legacy/source/2.5/**/*.bak
server/legacy/source/2.5/**/*.orig
server/legacy/source/2.5/**/*.rej
server/legacy/source/2.5/**/DEADJOE
server/legacy/source/2.5/**/*.scc
server/legacy/source/2.5/**/stoRkxhg
server/legacy/source/2.5/**/debug
server/legacy/source/2.5/**/nohup.out
server/legacy/source/2.5/**/log/*.log*
server/legacy/source/2.5/gmsv/log/
server/legacy/source/2.5/gmsv/lostpet/
server/legacy/source/2.5/saac/char/
server/legacy/source/2.5/saac/char_sleep/
