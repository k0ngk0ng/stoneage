# sactl 本地客户端配置示例。
#
# 复制到 runtime/sactl.toml（runtime/ 已被 gitignore）后填入真实凭据：
#   cp config/sactl/sactl.toml.example runtime/sactl.toml
#
# 不要把这个文件复制进仓库的受控路径，也不要把密码写进命令行参数。

# serve 监听的 Unix socket；一次性命令通过它找到守护进程。
socket_path = "runtime/sactl/sactl.sock"

# 传输方式：
#   tcp  （默认）直连命名协议网关，最快，适合本机开发
#   http 走部署的 Web 入口，用域名即可（无需隧道或开放游戏端口）
transport = "tcp"

# tcp：命名协议网关地址，不是 GMSV 的裸数字协议地址。
address = "127.0.0.1:9065"

# http：部署的 Web 地址（与浏览器同一个入口）。
# web_base_url = "https://sa.ichenj.com"
# 游戏线路 ID，留空则取 Web 服务列表里第一条可用线路。
# server_id = ""

# 专用账号：不要使用人类玩家正在使用的账号，同一个角色只能有一条连接。
account = "sactl"

# 密码二选一：password 直接写（文件权限自行收紧），或 password_file 指向
# 只含密码的文件（推荐）。两者都为空时只做连接测试。
password = ""
# password_file = "runtime/sactl-password"

# 登录后自动进入的角色。留空时停在角色列表，可用
# `sactl chars` / `sactl create-character <name>` / `sactl enter <name>` 操作。
character = ""

# 2.5 服务端数据目录：路由用 map/LS2MAP，跨图用 map/mapwarp.txt。
# 可以是 gmsv 数据目录（含 map/）、gmsv 目录或 map 目录本身。
map_directory = "runtime/legacy-server/gmsv/data"
