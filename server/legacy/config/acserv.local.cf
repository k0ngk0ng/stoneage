# Local-only SAAC configuration.
#
# The legacy SQL account module is disabled by the compatibility build. This
# file-backed runtime accepts accounts for protocol testing and must not be
# exposed to the Internet.

port 9300
pass test

rotate_interval 604800

logdir log
lockdir lock
chardir char
dbdir db
maildir mail
familydir data/family
fmpointdir data/fmpointdir
fmsmemodir data/fmsmemodir

Total_Charlist 3600
Expired_mail 600
Del_Family_or_Member 3600
Write_Family 600
SameIpMun 10
