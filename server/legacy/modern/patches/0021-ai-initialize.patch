+
+int ENEMY_createPetFromEnemyIndex( int charaindex, int array)
+{
+    int level;
+    int tarray;
+    int limit;
+    if( !ENEMY_CHECKINDEX( array)) return -1;
+    /* Preserve the legacy no-slot and missing-template fast paths before
+     * consuming RNG state, as well as its random-level semantics. */
+    if( CHAR_getCharPetElement( charaindex) < 0 ) return -1;
+    tarray = ENEMYTEMP_getEnemyTempArray( array);
+    if( !ENEMYTEMP_CHECKINDEX( tarray)) return -1;
+    level = RAND( ENEMY_getInt( array, ENEMY_LV_MIN),
+                  ENEMY_getInt( array, ENEMY_LV_MAX));
+    limit = ENEMYTEMP_getInt( tarray, E_T_LIMITLEVEL);
+    if( level >= 1 && level <= CHAR_MAXUPLEVEL &&
+        (limit <= 0 || level <= limit) ) {
+        return ENEMY_createPetFromEnemyIndexAtLevel(
+            charaindex, array, level);
+    }
+    /* Historic data may intentionally exceed a stale limit; retain that
+     * old path rather than rejecting a random pet that used to be created. */
+    return ENEMY_createPetFromEnemyIndexAtLevelInternal(
+        charaindex, array, level, FALSE);
 }
 
