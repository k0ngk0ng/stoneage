+/* STONEAGE_IDLE_NETLOOP_WAIT
+ * Count the table slots that could have something to read. netloop_faster
+ * shares its per-slot wait out over these, so the wait is divided between the
+ * sessions that can actually answer instead of between all fdnum slots.
+ */
+SINGLETHREAD static int CONNECT_countActiveFds( void )
+{
+  int i, count = 0;
+
+  for ( i = 0; i < ConnectLen; i++ ) {
+    if ( Connect[ i ].use ) count++;
+  }
+  return count;
+}
+
+/* STONEAGE_IDLE_NETLOOP_WAIT
+ * The pass ends at an absolute deadline that advances by one Onelooptime per
+ * pass, rather than one Onelooptime after each pass happened to start. The
+ * difference matters as soon as the wait is a real sleep: a sleep that gives
+ * the CPU back late then shortens the next wait instead of stretching the
+ * period. Walking and NPC movement advance once per pass, so a stretched tick
+ * is a game that runs slow.
+ *
+ * tick_deadline is in the future when this returns, so the caller's budget
+ * check still ends the pass at the deadline, and the window start is the
+ * deadline minus one Onelooptime.
+ */
+SINGLETHREAD static void CONNECT_advanceTickDeadline(
+    struct timeval* tick_deadline, struct timeval* window_start,
+    unsigned int looptime_us )
+{
+  struct timeval now;
+  long period = (long)looptime_us;
+  long lead_us;
 
+  gettimeofday( &now, NULL );
+  if ( tick_deadline->tv_sec == 0 && tick_deadline->tv_usec == 0 ) {
+    *tick_deadline = now;
+  }
+  tick_deadline->tv_usec += period;
+  while ( tick_deadline->tv_usec >= 1000000 ) {
+    tick_deadline->tv_usec -= 1000000;
+    tick_deadline->tv_sec++;
+  }
+  /* Hold the deadline within one period of now. A pass that gave the CPU
+     back late is followed by a shorter wait and the period is kept; only a
+     pass that fell a whole period behind, or a clock that stepped, starts a
+     fresh period instead of making the loop run back to back to catch up. */
+  lead_us = (long)( tick_deadline->tv_sec - now.tv_sec ) * 1000000L
+            + (long)( tick_deadline->tv_usec - now.tv_usec );
+  if ( lead_us > period || lead_us < -period ) {
+    *tick_deadline = now;
+    tick_deadline->tv_usec += period;
+    while ( tick_deadline->tv_usec >= 1000000 ) {
+      tick_deadline->tv_usec -= 1000000;
+      tick_deadline->tv_sec++;
+    }
+  }
+  *window_start = *tick_deadline;
+  window_start->tv_usec -= period;
+  while ( window_start->tv_usec < 0 ) {
+    window_start->tv_usec += 1000000;
+    window_start->tv_sec--;
+  }
+}
