+static void StoneAge_NativeBattleDispatch(int fd, int charaindex, char *command);
+void BattleCommandDispach(int fd, char *command)
+{
+    static int depth;
+    int character = CONNECT_getCharaindex(fd);
+    unsigned long request = StoneAge_BattleRecordRequest(character, command, depth);
+    depth++;
+    StoneAge_NativeBattleDispatch(fd, character, command);
+    depth--;
+    StoneAge_BattleRecordDispatch(character, request);
+}
+
+void StoneAge_BattleDatasetCommand(int character, char *command)
+{
+    unsigned long request = StoneAge_BattleRecordRequest(character, command, 0);
+    StoneAge_NativeBattleDispatch(-1, character, command);
+    StoneAge_BattleRecordDispatch(character, request);
+}
