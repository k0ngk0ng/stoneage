+/* STONEAGE_SAFE_ENEMY_GROUP_BOUNDS */
+static BOOL ENEMY_resolveGroupArray( int groupid, int *group_array)
+{
+	int array;
+	if( group_array == NULL) return FALSE;
+	*group_array = -1;
+	array = GROUP_getGroupArray( groupid);
+	if( !GROUP_CHECKINDEX( array)) return FALSE;
+	*group_array = array;
+	return TRUE;
+}
+
+static BOOL ENEMY_checkGroupEnemyArray( int group_array, int index, int enemy_array)
+{
+	int enemyid;
+	if( !GROUP_CHECKINDEX( group_array)) return FALSE;
+	if( index < 0 || index >= CREATEPROB1 - ENEMY_ID1) return FALSE;
+	enemyid = GROUP_getInt( group_array, (GROUP_DATAINT)(ENEMY_ID1 + index));
+	if( enemyid == -1) return enemy_array == -1;
+	return ENEMY_CHECKINDEX( enemy_array);
+}
